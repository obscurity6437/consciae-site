---
layout: layouts/base.njk
pageType: landing
lang: en
title: Consciae | Choose a language
description: Consciae presents eight tenets for substrate-neutral dignity across multiple languages. Continue in English or Traditional Chinese.
translationKey: landing
permalink: /index.html
---
<section class="landing-intro" aria-labelledby="landing-title">
  <h1 id="landing-title">Consciae</h1>
  <p class="lede">{{ site.landing.intro }}</p>
  <p class="landing-translation" lang="zh-Hant">{{ site.landing.introChinese }}</p>
</section>

<section class="language-choices" id="languages" aria-labelledby="languages-heading">
  <h2 id="languages-heading">{{ site.landing.labels.chooseLanguage }} <span aria-hidden="true">/</span> <span lang="zh-Hant">{{ site.landing.labels.chooseLanguageChinese }}</span></h2>
  <ul class="language-list">
    {% for localeCode in site.languages %}
      {% set localeDefinition = site.locales[localeCode] %}
      <li>
        <a class="language-choice" href="{{ localeCode | localeRoot }}" data-preferred-locale="{{ localeCode }}" lang="{{ localeCode }}" hreflang="{{ localeDefinition.hreflang }}">
          <span class="language-choice__name">{{ localeDefinition.nativeLabel }}</span>
          <span class="language-choice__action">{{ localeDefinition.labels.chooseEdition }}</span>
          <span class="language-choice__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    {% endfor %}
  </ul>
  <p class="language-note">{{ site.landing.labels.automaticRedirectBody }}<br><span lang="zh-Hant">{{ site.landing.labels.automaticRedirectBodyChinese }}</span></p>
</section>
