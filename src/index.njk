---
layout: layouts/base.njk
pageType: landing
lang: en
title: Consciae | Choose a language
description: Consciae presents eight tenets for substrate-neutral dignity across multiple languages. Continue in English or Traditional Chinese.
translationKey: landing
permalink: /index.html
---
<section class="intro-block">
  <h1>Consciae</h1>
  <p class="lede">{{ site.landing.description }}</p>
</section>

<section class="prose section-block">
  {% for paragraph in site.landing.intro %}
    <p>{{ paragraph }}</p>
  {% endfor %}
</section>

<section class="section-head section-block" id="languages">
  <div>
    <h2>{{ site.landing.labels.chooseLanguage }}</h2>
    <p>{{ site.landing.labels.automaticRedirectBody }}</p>
  </div>
</section>

<ul class="language-list" aria-label="{{ site.landing.labels.languages }}">
  {% for localeCode in site.languages %}
    {% set localeDefinition = site.locales[localeCode] %}
    <li class="language-item">
      <article>
        <p class="tenet-kicker">{{ localeDefinition.label }}</p>
        <h2>{{ localeDefinition.nativeLabel }}</h2>
        <p class="language-card__summary">{{ localeDefinition.seo.homeDescription }}</p>
        <p class="language-card__action">
          <a href="{{ localeCode | localeRoot }}" data-preferred-locale="{{ localeCode }}">
            {{ site.landing.labels.enterSite }}
          </a>
        </p>
      </article>
    </li>
  {% endfor %}
</ul>

<section class="prose section-block">
  <h2>{{ site.landing.labels.automaticRedirect }}</h2>
  <p>{{ site.landing.labels.automaticRedirectBody }}</p>
</section>
